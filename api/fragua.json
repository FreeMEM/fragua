   "max": 100,
   "set": "n.set_z_index(V)"
  },
  "visible": {
   "type": "Bool",
   "default": true,
   "es": "Se ve (con sus hijos)",
   "en": "Shown (with its children)",
   "set": "n.visible"
  },
