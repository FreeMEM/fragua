    add_animation(n4, "idle", [0], 1, true)
    add_animation(n4, "walk", [1, 2], 6, true)
    add_animation(n4, "jump", [3], 1, true)
    add_animation(n4, "idle_left", [4], 1, true)
    add_animation(n4, "walk_left", [5, 6], 6, true)
    add_animation(n4, "jump_left", [7], 1, true)
    n4.play("idle")
    n1.add_child(n4)
    n5 = new_shape_rect("Shape", 3, 1, 10, 15)
    n1.add_child(n5)
    return n1
