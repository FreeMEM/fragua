# The events of Player in the scene Player
struct PlayerEvents: Script
    fired: Int = 0                # events that happened

    func ready(n: Node)
    end

    func process(n: Node, delta: Int)
    end

    func physics_process(n: Node)
    end

    func on_signal(n: Node, name: String, from: Node, data: Int)
        other = node_by_id(data)
        if name == "jumped"
            play_sound("jump.8svx")
            self.fired = self.fired + 1
        end
        if name == "died"
            game_set("over", 1)
            self.fired = self.fired + 1
        end
    end
end

# The scene Player: a new tree each call
func scene_player() -> Node
