    end
    for o in map_objects(n2, "enemy")
        s = scene_enemy()
        s.set_pos(map_object_x(n2, o), map_object_y(n2, o))
        n1.add_child(s)
    end
    for o in map_objects(n2, "player")
        s = scene_player()
        s.set_pos(map_object_x(n2, o), map_object_y(n2, o))
        n1.add_child(s)
    end
    n3 = new_camera2d("Camera")
    n1.add_child(n3)
    n4 = new_label("Score", 8, 3, "", 13, 0)
    n4.label.bind = "score"
    n4.label.prefix = "SCORE "
    n1.add_child(n4)
    n5 = new_label("Lives", 240, 3, "", 15, 0)
    n5.label.bind = "lives"
    n5.label.prefix = "LIVES "
    n1.add_child(n5)
    n3.camera.target = n1.get_node("Player")
    if fragua_first_map(n1) != nil
        n3.camera.limit_w = map_pixel_width(fragua_first_map(n1))
        n3.camera.limit_h = map_pixel_height(fragua_first_map(n1))
