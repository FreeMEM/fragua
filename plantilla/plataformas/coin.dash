# The events of Coin in the scene Coin
struct CoinEvents: Script
    fired: Int = 0                # events that happened

    func ready(n: Node)
    end

    func process(n: Node, delta: Int)
    end

    func physics_process(n: Node)
    end

    func on_signal(n: Node, name: String, from: Node, data: Int)
        other = node_by_id(data)
        if name == "body_entered" and other != nil and other.is_in_group("player")
            game_add("score", 10)
            play_sound("coin.8svx")
            n.queue_free()
            self.fired = self.fired + 1
        end
    end
end

# The scene Coin: a new tree each call
func scene_coin() -> Node
    n1 = new_area2d("Coin", 0, 0)
    n1.add_behavior(CoinEvents())
    n2 = new_animated_sprite2d("Sprite", image_cached("coin.iff"), 0, 0)
    add_animation(n2, "spin", [0, 1, 2, 3], 6, true)
    n2.play("spin")
    n1.add_child(n2)
    n3 = new_shape_rect("Shape", 3, 2, 10, 12)
    n1.add_child(n3)
    return n1
end
