# Collisions and movement: boxes and circles, kinematic bodies that stop at the tile map and at solid bodies, and
# areas that tell who comes in and goes out. In whole pixels, with speeds in Fixed (16.16).
#
#   b = player.body
#   b.vy = b.vy + Fixed(0.4)            # gravity (or apply_gravity(player, Fixed(0.4), Fixed(6)))
#   accelerate_x(player, dir * 3, Fixed(0.5))   # towards a speed, so much a step
#   player.move_and_slide()
#   if b.on_floor and fire(1)
#       b.vy = Fixed(-6)                # a jump
#   end
#
# The map: the collision layer of the tile maps (TILE_SOLID, TILE_PLATFORM: only from above, TILE_SLOPE_UP and
# TILE_SLOPE_DOWN: the body walks on the slope; TILE_LADDER and TILE_DAMAGE do not stop it: n.touches_tile(kind)
# says if it is on one).
# Bodies: one with body.solid stops the others whose mask has its layer (body.layer & other.mask).
# Signals of a body: "landed" when it touches the floor (data: the speed it fell at, in 1/16 pixel a step), and
# "collided" when it stops at a solid body (data: its id).
# Areas: "body_entered", "body_exited", "area_entered", "area_exited" (data: the other one's id: node_by_id).

import "tree.dash"
import "world.dash"

# The box of a node in world coordinates, in these four (to make no Rect in the hot paths)
var fragua_bx: Int = 0
var fragua_by: Int = 0
var fragua_bw: Int = 0
var fragua_bh: Int = 0
var fragua_br: Int = 0                # a circle's radius (0: a box)

# Its shape (a SHAPE2D child, or itself), or else its picture (its own or its first child's)
func fragua_box(n: Node)
    gx = n.global_x()
    gy = n.global_y()
    fragua_br = 0
    if n.shape != nil
        fragua_shape_box(gx - n.x, gy - n.y, n)
        return
    end
    if n.col != nil
        fragua_shape_box(gx, gy, n.col)
        return
    end
    if n.sprite != nil
        fragua_bx = gx + n.sprite.ox
        fragua_by = gy + n.sprite.oy
        fragua_bw = n.sprite.width
        fragua_bh = n.sprite.height
        return
    end
    i = 0
    while i < n.children.length
        if n.children[i].sprite != nil
            fragua_bx = gx + n.children[i].x + n.children[i].sprite.ox
            fragua_by = gy + n.children[i].y + n.children[i].sprite.oy
            fragua_bw = n.children[i].sprite.width
            fragua_bh = n.children[i].sprite.height
            return
        end
        i = i + 1
    end
    fragua_bx = gx
    fragua_by = gy
    fragua_bw = 0
    fragua_bh = 0
end

# The box of a shape node sh whose parent is at px, py
func fragua_shape_box(px: Int, py: Int, sh: Node)
    if sh.shape.kind == SHAPE_CIRCLE
        fragua_br = sh.shape.r
        fragua_bx = px + sh.x - sh.shape.r
        fragua_by = py + sh.y - sh.shape.r
    else
        fragua_bx = px + sh.x
        fragua_by = py + sh.y
    end
    fragua_bw = sh.shape.w
    fragua_bh = sh.shape.h
end

# Its box kept in the node (bx, by, bw, bh, br), for the areas
func fragua_cache_box(n: Node)
    fragua_box(n)
    n.bx = fragua_bx
    n.by = fragua_by
    n.bw = fragua_bw
    n.bh = fragua_bh
    n.br = fragua_br
end

func fragua_hitbox(n: Node) -> Rect
    fragua_box(n)
    return Rect(fragua_bx, fragua_by, fragua_bw, fragua_bh)
end

# Two nodes overlap (boxes; circles with their radius)
func fragua_overlaps(a: Node, b: Node) -> Bool
    fragua_box(a)
    ax = fragua_bx
    ay = fragua_by
    aw = fragua_bw
    ah = fragua_bh
    ar = fragua_br
    fragua_box(b)
    if not (ax < fragua_bx + fragua_bw and fragua_bx < ax + aw and ay < fragua_by + fragua_bh and fragua_by < ay + ah)
        return false
    end
    if ar == 0 and fragua_br == 0
        return true
    end
    if ar > 0 and fragua_br > 0
        dx = (ax + ar) - (fragua_bx + fragua_br)
        dy = (ay + ar) - (fragua_by + fragua_br)
        rr = ar + fragua_br
        return dx * dx + dy * dy < rr * rr
    end
    # a circle and a box: the nearest point of the box to the centre
    cx = 0
    cy = 0
    bx = 0
    by = 0
    bw = 0
    bh = 0
    r = 0
    if ar > 0
        cx = ax + ar
        cy = ay + ar
        bx = fragua_bx
        by = fragua_by
        bw = fragua_bw
        bh = fragua_bh
        r = ar
    else
        cx = fragua_bx + fragua_br
        cy = fragua_by + fragua_br
        bx = ax
        by = ay
        bw = aw
        bh = ah
        r = fragua_br
    end
    px = cx
    if px < bx
        px = bx
    elif px > bx + bw - 1
        px = bx + bw - 1
    end
    py = cy
    if py < by
        py = by
    elif py > by + bh - 1
        py = by + bh - 1
    end
    return (px - cx) * (px - cx) + (py - cy) * (py - cy) < r * r
end

# --- the map, cell by cell ---
# Only the first tile map with a collision layer stops bodies (its numbers are kept in the tree once a frame:
# fragua_tree.cm_*), so these functions touch no object (Dash's reference counting makes that dear).

# The collision cell at a cell of the map (0 outside it)
func fragua_cm(c: Int, r: Int) -> Int
    if c < 0 or r < 0 or c >= fragua_tree.cm_w or r >= fragua_tree.cm_h
        return 0
    end
    return tilemap_get(fragua_tree.cm_id, fragua_tree.cm_layer, c, r) & 0x3FFF
end

# The cell (column or row) of a world coordinate; -1 for anything left of (or above) the map
func fragua_cm_col(wx: Int) -> Int
    if wx < fragua_tree.cm_x
        return -1
    end
    return (wx - fragua_tree.cm_x) / fragua_tree.cm_tile
end

func fragua_cm_row(wy: Int) -> Int
    if wy < fragua_tree.cm_y
        return -1
    end
    return (wy - fragua_tree.cm_y) / fragua_tree.cm_tile
end

# How far a box can go in x (dx) before a solid cell
func fragua_map_x(x: Int, y: Int, w: Int, h: Int, dx: Int) -> Int
    if fragua_tree.cm_id < 0 or dx == 0
        return dx
    end
    ts = fragua_tree.cm_tile
    r0 = fragua_cm_row(y)
    r1 = fragua_cm_row(y + h - 1)
    if dx > 0
        c = fragua_cm_col(x + w)
        c1 = fragua_cm_col(x + w - 1 + dx)
        while c <= c1
            r = r0
            while r <= r1
                if fragua_cm(c, r) == TILE_SOLID
                    return fragua_tree.cm_x + c * ts - (x + w)
                end
                r = r + 1
            end
            c = c + 1
        end
    else
        c = fragua_cm_col(x - 1)
        c1 = fragua_cm_col(x + dx)
        while c >= c1 and c >= 0
            r = r0
            while r <= r1
                if fragua_cm(c, r) == TILE_SOLID
                    return fragua_tree.cm_x + (c + 1) * ts - x
                end
                r = r + 1
            end
            c = c - 1
        end
    end
    return dx
end

# In y: solid cells, and platforms when going down from above them
func fragua_map_y(x: Int, y: Int, w: Int, h: Int, dy: Int) -> Int
    if fragua_tree.cm_id < 0 or dy == 0
        return dy
    end
    ts = fragua_tree.cm_tile
    c0 = fragua_cm_col(x)
    c1 = fragua_cm_col(x + w - 1)
    if dy > 0
        r = fragua_cm_row(y + h)
        r1 = fragua_cm_row(y + h - 1 + dy)
        while r <= r1
            top = fragua_tree.cm_y + r * ts
            c = c0
            while c <= c1
                v = fragua_cm(c, r)
                if v == TILE_SOLID or (v == TILE_PLATFORM and y + h <= top)
                    return top - (y + h)
                end
                c = c + 1
            end
            r = r + 1
        end
    else
        r = fragua_cm_row(y - 1)
        r1 = fragua_cm_row(y + dy)
        while r >= r1 and r >= 0
            c = c0
            while c <= c1
                if fragua_cm(c, r) == TILE_SOLID
                    return fragua_tree.cm_y + (r + 1) * ts - y
                end
                c = c + 1
            end
            r = r - 1
        end
    end
    return dy
end

# The floor of a slope under the point (px, py): its y in the world, or -1 if there is no slope there
func fragua_slope_floor(px: Int, py: Int) -> Int
    if fragua_tree.cm_id < 0
        return -1
    end
    c = fragua_cm_col(px)
    r = fragua_cm_row(py)
    v = fragua_cm(c, r)
    if v != TILE_SLOPE_UP and v != TILE_SLOPE_DOWN
        return -1
    end
    ts = fragua_tree.cm_tile
    local = px - fragua_tree.cm_x - c * ts
    rise = local + 1
    if v == TILE_SLOPE_DOWN
        rise = ts - local
    end
    return fragua_tree.cm_y + (r + 1) * ts - rise
end

# The kinds of collision tile under a box (a bit each)
func fragua_touching(x: Int, y: Int, w: Int, h: Int) -> Int
    bits = 0
    if fragua_tree.cm_id < 0
        return 0
    end
    r = fragua_cm_row(y)
    r1 = fragua_cm_row(y + h - 1)
    while r <= r1
        c = fragua_cm_col(x)
        c1 = fragua_cm_col(x + w - 1)
        while c <= c1
            v = fragua_cm(c, r)
            if v > 0 and v < 16
                bits = bits | (1 << v)
            end
            c = c + 1
        end
        r = r + 1
    end
    return bits
end

# --- solid bodies ---

var fragua_hit_id: Int = 0

func fragua_bodies_x(me: Node, x: Int, y: Int, w: Int, h: Int, dx: Int) -> Int
    fragua_hit_id = 0
    if fragua_tree.solids == 0
        return dx
    end
    i = 0
    while i < fragua_tree.bodies.length
        if fragua_tree.bodies[i].body.solid and fragua_tree.bodies[i] != me and (fragua_tree.bodies[i].body.layer & me.body.mask) != 0
            o = fragua_tree.bodies[i]
            fragua_box(o)
            if y < fragua_by + fragua_bh and fragua_by < y + h
                if dx > 0 and fragua_bx >= x + w and fragua_bx < x + w + dx
                    dx = fragua_bx - (x + w)
                    fragua_hit_id = o.id
                elif dx < 0 and fragua_bx + fragua_bw <= x and fragua_bx + fragua_bw > x + dx
                    dx = fragua_bx + fragua_bw - x
                    fragua_hit_id = o.id
                end
            end
        end
        i = i + 1
    end
    return dx
end

func fragua_bodies_y(me: Node, x: Int, y: Int, w: Int, h: Int, dy: Int) -> Int
    fragua_hit_id = 0
    if fragua_tree.solids == 0
        return dy
    end
    i = 0
    while i < fragua_tree.bodies.length
        if fragua_tree.bodies[i].body.solid and fragua_tree.bodies[i] != me and (fragua_tree.bodies[i].body.layer & me.body.mask) != 0
            o = fragua_tree.bodies[i]
            fragua_box(o)
            if x < fragua_bx + fragua_bw and fragua_bx < x + w
                if dy > 0 and fragua_by >= y + h and fragua_by < y + h + dy
                    dy = fragua_by - (y + h)
                    fragua_hit_id = o.id
                elif dy < 0 and fragua_by + fragua_bh <= y and fragua_by + fragua_bh > y + dy
                    dy = fragua_by + fragua_bh - y
                    fragua_hit_id = o.id
                end
            end
        end
        i = i + 1
    end
    return dy
end

# --- moving ---

func fragua_move_and_slide(n: Node)
    b = n.body
    if b == nil
        return
    end
    was_on_floor = b.on_floor
    fall = b.vy
    fragua_box(n)
    x = fragua_bx
    y = fragua_by
    w = fragua_bw
    h = fragua_bh
    b.on_wall = false
    b.on_ceiling = false
    b.on_floor = false
    # x: whole pixels of the speed, the rest kept for the next step
    b.rx = b.rx + b.vx
    dx = Int(b.rx)
    b.rx = b.rx - dx
    if dx != 0
        want = dx
        if b.collide_map
            # going up a slope: the floor under the front foot rises; that is not a wall
            dx = fragua_map_x(x, y, w, h, dx)
        end
        dx = fragua_bodies_x(n, x, y, w, h, dx)
        if fragua_hit_id != 0
            b.hit = fragua_hit_id
            n.emit("collided", fragua_hit_id)
        end
        if dx != want
            b.on_wall = true
            b.rx = 0
            b.vx = 0 - b.vx * b.bounce
        end
        n.x = n.x + dx
        x = x + dx
    end
    # y
    b.ry = b.ry + b.vy
    dy = Int(b.ry)
    b.ry = b.ry - dy
    want = dy
    if dy >= 0
        # one pixel more to know if it stands on something
        dy = dy + 1
    end
    if b.collide_map
        dy = fragua_map_y(x, y, w, h, dy)
    end
    dy = fragua_bodies_y(n, x, y, w, h, dy)
    if fragua_hit_id != 0
        b.hit = fragua_hit_id
    end
    if want >= 0
        if dy < want + 1
            b.on_floor = true
        else
            dy = want
        end
    elif dy != want
        b.on_ceiling = true
    end
    if (b.on_floor and b.vy > 0) or (b.on_ceiling and b.vy < 0)
        b.ry = 0
        b.vy = 0 - b.vy * b.bounce
        if b.on_floor and b.bounce == 0
            b.vy = 0
        end
    end
    n.y = n.y + dy
    y = y + dy
    # slopes: the foot (the middle of the bottom edge) on the floor of the slope
    if b.collide_map and b.vy >= 0 and fragua_tree.cm_slopes
        fx = x + w / 2
        f = fragua_slope_floor(fx, y + h - 1)
        if f < 0 and was_on_floor
            f = fragua_slope_floor(fx, y + h + h / 2)   # walking down a slope: stay on it
        end
        if f < 0
            f = fragua_slope_floor(fx, y + h)
            if f >= 0 and f > y + h
                f = -1
            end
        end
        if f >= 0 and y + h > f - 1 - h / 2
            n.y = n.y + (f - (y + h))
            y = f - h
            b.on_floor = true
            b.vy = 0
            b.ry = 0
        end
    end
    if b.on_floor and not was_on_floor
        n.emit("landed", Int(fall * 16))
        b.floor_tile = fragua_cell_under(x, y, w, h)
    end
end

func fragua_cell_under(x: Int, y: Int, w: Int, h: Int) -> Int
    v = tile_at(x + w / 2, y + h)
    if v == 0
        v = tile_at(x, y + h)
    end
    if v == 0
        v = tile_at(x + w - 1, y + h)
    end
    return v
end

# Towards the speed target (in pixels a step), changing at most rate each time: acceleration and braking
func accelerate_x(n: Node, target: Fixed, rate: Fixed)
    b = n.body
    if b.vx < target
        b.vx = b.vx + rate
        if b.vx > target
            b.vx = target
        end
    elif b.vx > target
        b.vx = b.vx - rate
        if b.vx < target
            b.vx = target
        end
    end
end

func accelerate_y(n: Node, target: Fixed, rate: Fixed)
    b = n.body
    if b.vy < target
        b.vy = b.vy + rate
        if b.vy > target
            b.vy = target
        end
    elif b.vy > target
        b.vy = b.vy - rate
        if b.vy < target
            b.vy = target
        end
    end
end

# Friction: the speed in x goes towards 0 by so much a step
func friction_x(n: Node, amount: Fixed)
    accelerate_x(n, 0, amount)
end

# Gravity, up to a falling speed
func apply_gravity(n: Node, g: Fixed, max_fall: Fixed)
    b = n.body
    b.vy = b.vy + g
    if b.vy > max_fall
        b.vy = max_fall
    end
end

# --- areas: who comes in and goes out, at each physics step ---
# The boxes are worked out once a step (fragua_cache_box) and compared in place: with 25 coins and 9 bodies this
# is what costs most, and Dash's reference counting makes each object kept in a variable dear.

func fragua_area_enter(a: Node, o: Node, kind: String)
    a.area.inside.push(o.id)
    a.emit(kind + "_entered", o.id)
end

func fragua_area_leave(a: Node, k: Int, kind: String)
    id = a.area.inside[k]
    a.area.inside.remove(k)
    a.emit(kind + "_exited", id)
end

# Do the cached boxes of a and o overlap (circles with their radius)
func fragua_cached_overlap(a: Node, o: Node) -> Bool
    if not (a.bx < o.bx + o.bw and o.bx < a.bx + a.bw and a.by < o.by + o.bh and o.by < a.by + a.bh)
        return false
    end
    if a.br == 0 and o.br == 0
        return true
    end
    return fragua_overlaps(a, o)
end

func fragua_area_scan(a: Node)
    mask = a.area.mask
    # who left: out of the tree (no signal) or not overlapping now
    k = a.area.inside.length - 1
    while k >= 0
        o = node_by_id(a.area.inside[k])
        if o == nil or o.dead
            a.area.inside.remove(k)
        elif not fragua_cached_overlap(a, o)
            if o.area != nil
                fragua_area_leave(a, k, "area")
            else
                fragua_area_leave(a, k, "body")
            end
        end
        k = k - 1
    end
    # who came in
    j = 0
    while j < fragua_tree.bodies.length
        if (fragua_tree.bodies[j].body.layer & mask) != 0
            if a.bx < fragua_tree.bodies[j].bx + fragua_tree.bodies[j].bw and fragua_tree.bodies[j].bx < a.bx + a.bw and a.by < fragua_tree.bodies[j].by + fragua_tree.bodies[j].bh and fragua_tree.bodies[j].by < a.by + a.bh
                o = fragua_tree.bodies[j]
                if o != a.parent and not o.dead and not a.area.inside.has(o.id) and fragua_cached_overlap(a, o)
                    fragua_area_enter(a, o, "body")
                end
            end
        end
        j = j + 1
    end
    if fragua_tree.area_layers != 0 and (fragua_tree.area_layers & mask) != 0
        j = 0
        while j < fragua_tree.areas.length
            if (fragua_tree.areas[j].area.layer & mask) != 0 and fragua_tree.areas[j].active and fragua_tree.areas[j] != a
                o = fragua_tree.areas[j]
                if not o.dead and not a.area.inside.has(o.id) and fragua_cached_overlap(a, o)
                    fragua_area_enter(a, o, "area")
                end
            end
            j = j + 1
        end
    end
end

func fragua_areas_update()
    if fragua_tree.areas.length == 0
        return
    end
    layers = 0
    i = 0
    while i < fragua_tree.areas.length
        if fragua_tree.areas[i].active
            fragua_cache_box(fragua_tree.areas[i])
            layers = layers | fragua_tree.areas[i].area.layer
        end
        i = i + 1
    end
    fragua_tree.area_layers = layers
    i = 0
    while i < fragua_tree.bodies.length
        fragua_cache_box(fragua_tree.bodies[i])
        i = i + 1
    end
    i = 0
    while i < fragua_tree.areas.length
        if fragua_tree.areas[i].active and fragua_tree.areas[i].area.monitoring and not fragua_tree.areas[i].dead
            fragua_area_scan(fragua_tree.areas[i])
        end
        i = i + 1
    end
end
