# Clock: keeps the count of frames. present() of the screen already waits for the vertical blank; tick(), right
# after it, says how many frames went by since the last tick: 1 when the game keeps up, more when it was late (the
# game then moves things that many steps and draws once: it loses smoothness, not speed).
#
#   clock = clock_new(50)      # 50 frames a second (PAL; 60 in NTSC)
#   n = clock.tick()
#   clock.lost                 # frames lost so far

struct Clock
    rate: Int
    last: Int             # time_ms of the last tick
    frames: Int           # frames gone by
    lost: Int

    func tick() -> Int
        now = time_ms()
        n = 1
        if self.last > 0
            period = 1000 / self.rate
            n = (now - self.last + period / 2) / period
            if n < 1
                n = 1
            end
        end
        self.last = now
        self.frames = self.frames + n
        self.lost = self.lost + n - 1
        return n
    end
end

func clock_new(rate: Int) -> Clock
    return Clock(rate, 0, 0, 0)
end
