# Lo que cuesta cada pieza de la capa 1 de Fragua, en una pantalla de 320x256 con 5 planos y doble búfer. Escribe
# los milisegundos de cada cosa (la media de N veces).

import "../fragua.dash"

const N = 50

func ms(t0: Int, n: Int) -> String
    t = (time_ms() - t0) * 100 / n
    return "#{t / 100}.#{(t % 100) / 10}#{t % 10}"
end

Main
    s = screen_open(320, 256, 5, "Costes")
    if s == nil
        Print "no abre la pantalla"
    else
        img16 = image_new(16, 16, 1, 5)
        img16.paint_start()
        gfx_pen(7)
        gfx_rect(2, 2, 13, 13)
        img16.paint_end()
        img32 = image_new(32, 32, 1, 5)
        img32.paint_start()
        gfx_pen(9)
        gfx_rect(2, 2, 29, 29)
        img32.paint_end()
        a = Rect(10, 10, 16, 16)
        b = Rect(20, 20, 16, 16)
        g = group_new()
        i = 0
        while i < 20
            g.add(sprite_new(img16, i * 15, 100))
            i = i + 1
        end
        r = ""
        t0 = time_ms()
        i = 0
        while i < N
            s.clear(0)
            i = i + 1
        end
        r = r + "borrar la pantalla: " + ms(t0, N) + " ms\n"
        t0 = time_ms()
        i = 0
        while i < N
            s.rect(i, 40, 32, 32, 3)
            i = i + 1
        end
        r = r + "rectángulo de 32x32: " + ms(t0, N) + " ms\n"
        t0 = time_ms()
        i = 0
        while i < N
            img16.draw(i * 5, 80, 0)
            i = i + 1
        end
        r = r + "imagen de 16x16 con máscara: " + ms(t0, N) + " ms\n"
        t0 = time_ms()
        i = 0
        while i < N
            img32.draw(i * 5, 120, 0)
            i = i + 1
        end
        r = r + "imagen de 32x32 con máscara: " + ms(t0, N) + " ms\n"
        t0 = time_ms()
        i = 0
        while i < N
            s.text(10, 200, "Puntos: 12345", 1)
            i = i + 1
        end
        r = r + "texto de 13 letras: " + ms(t0, N) + " ms\n"
        t0 = time_ms()
        i = 0
        while i < N
            k = key(KEY_ESC)
            i = i + 1
        end
        r = r + "key_down: " + ms(t0, N) + " ms\n"
        t0 = time_ms()
        i = 0
        c = 0
        while i < N * 20
            if a.collides(b)
                c = c + 1
            end
            i = i + 1
        end
        r = r + "Rect.collides: " + ms(t0, N * 20) + " ms\n"
        t0 = time_ms()
        i = 0
        while i < N
            h = g.colliding(g.sprites[0])
            i = i + 1
        end
        r = r + "Group.colliding con 20: " + ms(t0, N) + " ms\n"
        t0 = time_ms()
        i = 0
        while i < N
            g.draw()
            i = i + 1
        end
        r = r + "Group.draw con 20 de 16x16: " + ms(t0, N) + " ms\n"
        t0 = time_ms()
        i = 0
        while i < 20
            s.present()
            i = i + 1
        end
        r = r + "present (cambiar de búfer y esperar): " + ms(t0, 20) + " ms\n"
        img16.free()
        img32.free()
        s.close()
        Print r
    end
end
