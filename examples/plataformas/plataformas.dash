# A small platform game with Fragua's nodes, made of scenes (the .escena files, turned into the .dash files next
# to them by tools/escena.py, as Forja's scene editor will): a level of Forja's map editor (level1.fmap), a player
# that runs and jumps (the Platformer behaviour), enemies that patrol and that the player can stomp, coins that add
# to the score (events without code), a camera that goes a screen at a time and the score on top.
# Arrows or joystick, space or fire to jump, Esc quits. With ENV:FRAGUA_DEMO the player plays by itself for 600
# frames and it prints what it measured (for the tests).

import "../../fragua.dash"
import "level1.dash"

# The enemy: walks (Patrol); if the player falls on it, it dies; if not, it hurts the player
struct Enemy: Script
    points: Int = 50

    func ready(n: Node)
    end

    func process(n: Node, delta: Int)
    end

    func physics_process(n: Node)
        for p in get_nodes_in_group("player")
            if n.overlaps(p)
                fragua_box(n)
                top = fragua_by
                fragua_box(p)
                if p.body.vy > 0 and fragua_by + fragua_bh <= top + 6
                    p.body.vy = Fixed(-4)
                    game_add("score", self.points)
                    play_sound("hit.8svx")
                    n.queue_free()
                else
                    send_signal(p, "damage", n, 1)
                end
            end
        end
    end

    func on_signal(n: Node, name: String, from: Node, data: Int)
    end
end

# The player: the Platformer and Health behaviours do the moving and the life, and the scene's events the sounds
# (player.escena); this script sends it back to the start when it falls out of the world or onto spikes
struct Player: Script
    falls: Int = 0

    func ready(n: Node)
    end

    func process(n: Node, delta: Int)
        if n.y > 260 or n.touches_tile(TILE_DAMAGE)
            self.falls = self.falls + 1
            send_signal(n, "damage", n, 1)
            n.set_pos(32, 160)
            n.body.vy = 0
        end
    end

    func physics_process(n: Node)
    end

    func on_signal(n: Node, name: String, from: Node, data: Int)
    end
end

# The demo: runs right and jumps every so often
struct Bot: Script
    t: Int = 0

    func ready(n: Node)
        action_force("right", true)
    end

    func process(n: Node, delta: Int)
        self.t = self.t + delta
        action_force("jump", (self.t % 40) < 2)
        if fragua_tree.frames >= 600
            quit()
        end
    end

    func physics_process(n: Node)
    end

    func on_signal(n: Node, name: String, from: Node, data: Int)
    end
end

Main
    demo = env_get("FRAGUA_DEMO") != ""
    s = open_screen(320, 256, 5, "Plataformas")
    if s == nil
        Print "plataformas: the screen does not open"
    else
        s.palette("tiles.iff", 0)
        set_view(0, 16, 320, 240)         # the world under a bar of 16 lines for the score
        set_background_color(3)
        set_hud_color(0)
        if env_get("FRAGUA_50") == ""
            set_frame_rate(25)            # an A1200 draws about ten BOBs in a frame of 50: this level has more
        end
        root = scene_level1()             # level1.escena: the map, its coins, enemies and player, camera, score
        if demo
            b = new_node("Bot")
            b.script = Bot()
            root.add_child(b)
        end
        run(root)
        t = fragua_tree
        if demo
            Print "plataformas: #{t.frames} frames, lost #{t.lost}, work #{t.work / t.frames} ms a frame (at most #{t.worst}), physics #{t.ms_physics / t.frames}, process #{t.ms_process / t.frames}, draw #{t.ms_draw / t.frames}, score #{game_get("score")}, lives #{game_get("lives")}"
        end
        close_screen(s)
    end
end
