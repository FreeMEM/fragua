{
  "fragua": 1,
  "name": "Player",
  "root": {
    "type": "Body2D", "name": "Player",
    "groups": ["player"],
    "script": "Player",
    "behaviors": [
      {"type": "Platformer"},
      {"type": "Health", "props": {"hp": 3, "var_name": "lives", "destroy": false}}
    ],
    "events": [
      {"signal": "jumped", "actions": [{"do": "sound", "file": "jump.8svx"}]},
      {"signal": "died", "actions": [{"do": "set", "var": "over", "value": 1}]}
    ],
    "children": [
      {"type": "AnimatedSprite2D", "name": "Sprite",
       "props": {"image": "player.iff", "autoplay": "idle", "animations": {
         "idle": {"frames": [0], "speed": 1}, "walk": {"frames": [1, 2], "speed": 6}, "jump": {"frames": [3], "speed": 1},
         "idle_left": {"frames": [4], "speed": 1}, "walk_left": {"frames": [5, 6], "speed": 6}, "jump_left": {"frames": [7], "speed": 1}}}},
      {"type": "CollisionShape2D", "name": "Shape", "props": {"rect": [3, 1, 10, 15]}}
    ]
  }
}
